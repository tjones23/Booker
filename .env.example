# Production settings for run-prod.command. Copy to .env (never committed) and
# fill in. Each name maps onto appsettings.json, with __ for nesting.
#
# Lines are read by the shell: wrap any value containing spaces, $, ! or
# quotes in 'single quotes'.

# The tutor's login at /Account/Login. run-prod.command won't make the site
# public while this is still the demo password from appsettings.json.
Admin__Username=admin
Admin__Password=''

# SMTP for intake notifications. Leave Email__Host empty and the app only logs
# the email instead of sending it. Gmail needs an App Password, not the
# account's own password.
Email__Host=smtp.gmail.com
Email__Username=1@2.com
Email__Password=''
# Intake and booking notifications go to Email:BusinessAddress in
# appsettings.json; override it here only if that changes.
# Email__BusinessAddress=rootedreaders123@gmail.com
