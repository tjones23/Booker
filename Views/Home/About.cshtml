@{
    ViewData["Title"] = "About";
}

<section class="container my-5" style="max-width: 820px;">
    <div class="text-center mb-4">
        <span class="service-icon mb-3"><i class="bi bi-person-heart"></i></span>
        <h1>About Ms. Amani</h1>
        <p class="text-muted">Educator, reading specialist, and your child's biggest cheerleader.</p>
    </div>

    <div class="card p-4 p-md-5">
        <p>
            Hi, I'm <strong>Ms. Amani</strong>. I hold a Bachelor's degree in Elementary Education
            and a Master's in Special Education, and I spent 13 years teaching in the classroom
            before opening Rooted Readers in August 2023.
        </p>
        <p>
            My approach is grounded in the <strong>Science of Reading</strong> — the large body of
            research on how children actually learn to read. Every session is structured, explicit,
            and multisensory, so students build skills in a way that sticks.
        </p>

        <h5 class="mt-4">Training &amp; credentials</h5>
        <ul class="list-unstyled">
            <li class="mb-2"><i class="bi bi-patch-check-fill text-primary me-2"></i>M.Ed., Special Education</li>
            <li class="mb-2"><i class="bi bi-patch-check-fill text-primary me-2"></i>Orton-Gillingham+ (Institute for Multisensory Education)</li>
            <li class="mb-2"><i class="bi bi-patch-check-fill text-primary me-2"></i>Unlocking the Reading &amp; Grammar Code</li>
            <li class="mb-2"><i class="bi bi-patch-check-fill text-primary me-2"></i>Multisensory Math training</li>
            <li class="mb-2"><i class="bi bi-hourglass-split text-primary me-2"></i>In progress: Barton Reading &amp; Spelling System</li>
        </ul>

        <div class="text-center mt-4">
            <a class="btn btn-primary btn-lg px-4" asp-controller="Intake" asp-action="Index">
                Book a free assessment
            </a>
        </div>
    </div>
</section>
