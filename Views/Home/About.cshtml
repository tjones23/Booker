@{
    ViewData["Title"] = "About";
}

<section class="container my-5" style="max-width: 820px;">
    <div class="text-center mb-4">
        <span class="service-icon mb-3"><i class="bi bi-person-heart"></i></span>
        <h1>About Ms. Amani</h1>
        <p class="text-muted">Educator, reading specialist, and your child's biggest cheerleader.</p>
    </div>

    <div class="card p-4 p-md-5">
        <p>
            Hi, I'm <strong>Ms. Amani</strong>. I'm a Licensed Colorado Teacher and AMS Primary
            Certified educator with 20 years of tutoring experience and 3 years in the classroom.
            I founded Rooted Readers to give children ages 4–12 the individualized, evidence-based
            literacy and math support they deserve.
        </p>
        <p>
            She has deep knowledge of Orton-Gillingham and LETRS — having trained under a certified
            practitioner and studied both curricula extensively — and is currently completing her
            AMS Lower Elementary credential.
        </p>
        <p>
            My approach is grounded in the <strong>Science of Reading</strong> — the large body of
            research on how children actually learn to read. Every session is structured, explicit,
            and multisensory, so students build skills in a way that sticks.
        </p>

        <h5 class="mt-4">Training &amp; credentials</h5>
        <ul class="list-unstyled">
            <li class="mb-2"><i class="bi bi-patch-check-fill text-primary me-2"></i>Colorado Licensed Elementary Educator</li>
            <li class="mb-2"><i class="bi bi-patch-check-fill text-primary me-2"></i>AMS Primary (Ages 3-6)</li>
            <li class="mb-2"><i class="bi bi-patch-check-fill text-primary me-2"></i>Science of Reading</li>
            <li class="mb-2"><i class="bi bi-hourglass-split text-primary me-2"></i>In progress: AMS Lower Elementary (Ages 6-9)</li>
        </ul>

        <div class="text-center mt-4">
            <a class="btn btn-primary btn-lg px-4" asp-controller="Intake" asp-action="Index">
                Book a free assessment
            </a>
        </div>
    </div>
</section>
