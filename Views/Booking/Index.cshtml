@model List<Service>
@{
    ViewData["Title"] = "Book a session";
}

<section class="container my-5">
    <div class="text-center mb-2">
        <span class="hero-badge px-3 py-1 d-inline-block mb-2">Step 1 of 3</span>
        <h1>Choose a service</h1>
        <p class="text-muted">Select what you'd like to book. Next you'll pick a day and time.</p>
    </div>

    <div class="row g-4 justify-content-center mt-2">
        @foreach (var service in Model)
        {
            <div class="col-md-6 col-lg-4">
                <a class="text-decoration-none text-reset"
                   asp-action="Schedule" asp-route-serviceId="@service.Id">
                    <div class="card h-100 p-4 lift">
                        <span class="service-icon mb-3"><i class="bi bi-@service.Icon"></i></span>
                        <h5>@service.Name</h5>
                        <p class="small text-muted flex-grow-1">@service.Tagline</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="price-pill px-3 py-1 small">@service.PriceDisplay</span>
                            <span class="small text-muted">@service.DurationMinutes min</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</section>
