@model LoginViewModel
@{
    ViewData["Title"] = "Tutor login";
}

<section class="container my-5" style="max-width: 420px;">
    <div class="card p-4">
        <div class="text-center mb-3">
            <span class="service-icon mb-2"><i class="bi bi-lock"></i></span>
            <h1 class="h3">Tutor login</h1>
            <p class="text-muted small mb-0">Sign in to manage your bookings.</p>
        </div>
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="All" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>
        <p class="small text-muted mt-3 mb-0">
            <i class="bi bi-info-circle me-1"></i>Demo credentials: <code>admin</code> / <code>ChangeMe123!</code>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
