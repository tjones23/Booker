@model List<Service>
@{
    ViewData["Title"] = "Services";
}

<section class="container my-5">
    <div class="text-center mb-5">
        <h1>Tutoring services</h1>
        <p class="text-muted">Evidence-based, one-on-one support tailored to your child.</p>
    </div>

    <div class="row g-4">
        @foreach (var service in Model)
        {
            <div class="col-md-6">
                <div class="card h-100 p-4 lift">
                    <div class="d-flex align-items-start gap-3">
                        <span class="service-icon"><i class="bi bi-@service.Icon"></i></span>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <h4 class="mb-1">@service.Name</h4>
                                <span class="price-pill px-3 py-1 small">@service.PriceDisplay</span>
                            </div>
                            <p class="text-muted mb-2">@service.Tagline</p>
                            <p class="small">@service.Description</p>
                            <div class="small text-muted mb-3">
                                <i class="bi bi-clock me-1"></i>@service.CadenceDisplay
                            </div>
                            <div class="d-flex gap-2">
                                <a class="btn btn-primary btn-sm"
                                   asp-controller="Booking" asp-action="Schedule" asp-route-serviceId="@service.Id">
                                    Book this
                                </a>
                                <a class="btn btn-outline-primary btn-sm"
                                   asp-controller="Services" asp-action="Details" asp-route-slug="@service.Slug">
                                    Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
