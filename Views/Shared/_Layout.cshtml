@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rooted Readers</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-white shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half text-primary me-1"></i>Rooted Readers
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-md-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Services" asp-action="Index">Services</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Intake" asp-action="Index">Intake Form</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Sign out</button>
                                </form>
                            </li>
                        }
                        <li class="nav-item ms-md-2">
                            <a class="btn btn-primary px-3" asp-controller="Booking" asp-action="Index">Book a session</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @if (TempData["Flash"] is string flash)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @flash
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-4 bg-dark text-light">
        <div class="container">
            <div class="row gy-3">
                <div class="col-md-5">
                    <h6 class="fw-bold"><i class="bi bi-book-half me-1"></i>Rooted Readers</h6>
                    <p class="small text-light-emphasis mb-0">
                        One-on-one literacy and math tutoring rooted in the Science of Reading.
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold">Contact</h6>
                    <p class="small mb-1"><i class="bi bi-envelope me-2"></i>hello@rootedreaders.com</p>
                    <p class="small mb-0"><i class="bi bi-telephone me-2"></i>(970) 590-1067</p>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold">Quick links</h6>
                    <a class="d-block small link-light" asp-controller="Services" asp-action="Index">Services</a>
                    <a class="d-block small link-light" asp-controller="Booking" asp-action="Index">Book a session</a>
                    <a class="d-block small link-light" asp-controller="Account" asp-action="Login">Tutor login</a>
                </div>
            </div>
            <hr class="border-secondary" />
            <div class="small text-light-emphasis">&copy; 2026 Rooted Readers. Demo application.</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
