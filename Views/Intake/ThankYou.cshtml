@{
    ViewData["Title"] = "Thank you";
}

<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
<style>
    .rr-success-wrap {
        max-width: 660px; margin: 3rem auto; background: #fff; border-radius: 16px;
        border: .5px solid #C8E8DC; box-shadow: 0 4px 24px rgba(15,110,86,.07);
        text-align: center; padding: 3rem 2rem; font-family: 'DM Sans', sans-serif;
    }
    .rr-logo-mark { width: 56px; height: 56px; background: #E1F5EE; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; }
    .rr-success-wrap h2 { font-family: 'Lora', serif; font-size: 22px; font-weight: 500; color: #0F6E56; margin-bottom: .75rem; }
    .rr-success-wrap p { font-size: 14px; color: #4a6b5f; line-height: 1.6; }
    .rr-success-wrap a { color: #0F6E56; }
</style>

<div class="rr-success-wrap">
    <div class="rr-logo-mark">
        <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M15 4 C15 4 8 11 8 18 C8 22.5 11.5 26 15 26 C18.5 26 22 22.5 22 18 C22 11 15 4 15 4Z" fill="#1D9E75" opacity="0.75" />
            <path d="M15 11 C15 11 10.5 15.5 10.5 19.5 C10.5 22.5 12.5 24.5 15 25" stroke="#085041" stroke-width="1.2" fill="none" stroke-linecap="round" />
            <line x1="15" y1="26" x2="15" y2="29.5" stroke="#085041" stroke-width="1.5" stroke-linecap="round" />
        </svg>
    </div>
    <h2>Thank you!</h2>
    <p>
        Your intake form has been received. Ms. Amani will be in touch soon to schedule
        your free 20-minute consultation.<br /><br />— Rooted Readers
    </p>
    <p class="mt-3"><a asp-controller="Home" asp-action="Index">Return to home</a></p>
</div>
